{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    { "source": "/images/:path*", "destination": "/api/files/:path*" },
    { "source": "/pub/:path*", "destination": "/api/pub/:path*" },
    { "source": "/apps-script.gs", "destination": "/api/apps-script" }
  ],
  "functions": {
    "api/**": { "maxDuration": 60, "includeFiles": "planilha/**" }
  },
  "crons": [{ "path": "/api/cron", "schedule": "0 11 * * *" }]
}
