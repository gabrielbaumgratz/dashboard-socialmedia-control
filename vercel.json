{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/images/:path*",
      "destination": "/api/index?__p=images/:path*"
    },
    {
      "source": "/pub/:path*",
      "destination": "/api/index?__p=pub/:path*"
    },
    {
      "source": "/apps-script.gs",
      "destination": "/api/index?__p=api/apps-script"
    },
    {
      "source": "/api/:path*",
      "destination": "/api/index?__p=api/:path*"
    }
  ],
  "functions": {
    "api/**": {
      "maxDuration": 60,
      "includeFiles": "planilha/**"
    }
  },
  "crons": [
    {
      "path": "/api/cron",
      "schedule": "0 11 * * *"
    }
  ]
}